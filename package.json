{
  "name": "ideaton-ucb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"for (const path of ['dist', 'server.js']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint": "eslint src scripts vite.config.ts vitest.config.ts eslint.config.js",
    "format": "prettier --write src/**/*.{ts,tsx,css} scripts/**/*.mjs *.{json,md,html,ts,js}",
    "format:check": "prettier --check src/**/*.{ts,tsx,css} scripts/**/*.mjs *.{json,md,html,ts,js}",
    "test": "vitest run",
    "test:watch": "vitest",
    "precommit": "lint-staged && npm run lint",
    "prepush": "npm run test",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:agent": "npm run lint && npm run test && npm run build",
    "typecheck": "tsc --noEmit",
    "test:visual": "node scripts/capture-visual.mjs .visual-current",
    "test:media": "node scripts/test-video-playback.mjs",
    "visual:baseline": "node scripts/capture-visual.mjs .visual-baseline",
    "visual:compare": "node scripts/compare-visual.mjs .visual-baseline .visual-current",
    "media:prepare": "node scripts/prepare-media.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@derhuerst/ffprobe-static": "^5.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,css}": "prettier --write",
    "*.{json,md,html,ts}": "prettier --write"
  },
  "trustedDependencies": [
    "@derhuerst/ffprobe-static"
  ]
}
